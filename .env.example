# All keys are OPTIONAL — the app runs in demo mode without any of them,
# using the curated Singapore place catalog and template explanations.

# Google Places API (New) key — adds live nearby restaurants to the candidate pool.
# https://developers.google.com/maps/documentation/places/web-service/get-api-key
GOOGLE_PLACES_API_KEY=

# Anthropic API key — generates the one-line "why this pick" explanations with Claude.
# Without it, a template-based explanation is used.
ANTHROPIC_API_KEY=

# Override the Claude model used for explanations (defaults to claude-opus-5).
CLAUDE_MODEL=

# Postgres connection string (Neon/Supabase) — reserved for the persistence upgrade
# described in prisma/schema.prisma. The current scaffold stores the taste profile
# in a cookie and needs no database.
DATABASE_URL=
