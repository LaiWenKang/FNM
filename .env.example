# Every key here is OPTIONAL. With none of them set the app still runs:
# curated Singapore catalog, template explanations, guest mode, profile stored
# in a cookie on the user's own device.

# ── Restaurants ────────────────────────────────────────────────────────────
# Google Places API (New) key — adds live nearby restaurants to the candidate
# pool. https://developers.google.com/maps/documentation/places/web-service/get-api-key
GOOGLE_PLACES_API_KEY=

# ── Explanations ───────────────────────────────────────────────────────────
# Anthropic API key — Claude writes the one-line "why this pick" sentence.
# Without it a deterministic template is used.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# ── Accounts (Google sign-in) ──────────────────────────────────────────────
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Any long random string — signs the session cookie. Required for sign-in.
AUTH_SECRET=
# Set to "true" to make sign-in mandatory (every page redirects to /signin).
# Ignored unless the Google keys above are also set, so a misconfigured deploy
# can never lock everyone out.
REQUIRE_AUTH=

# ── Where user data is stored ──────────────────────────────────────────────
# Postgres connection string (Neon or Supabase — pick the Singapore region).
# Set it and signed-in users' taste profiles are stored server-side in a
# `profiles` table (created automatically on first use) so they sync across
# devices. Leave it blank and every profile stays in a device cookie.
DATABASE_URL=
